      type: text-cell-h2
      sortingKey: bi
      content: 11. GROUP BY
    - id: 32a5c850c8f143ffa1ac50d39a283631
      blockGroup: 32a5c850c8f143ffa1ac50d39a283631
      type: text-cell-p
      sortingKey: bj
      content: 'GROUP BY calcula las agregaciones por grupo. Regla: toda columna del SELECT que no esté
        dentro de una agregación debe estar en el GROUP BY.'
    - id: 235166ef23454284b8f976b67881610f
      blockGroup: 235166ef23454284b8f976b67881610f
      type: sql
      sortingKey: bk
      content: |
        SELECT
            payment_type AS tipo_pago,
            COUNT(*) AS viajes,
            ROUND(AVG(tip_amount), 2) AS propina_promedio
        FROM viajes
        GROUP BY payment_type
        ORDER BY viajes DESC
      metadata:
        sql_integration_id: deepnote-dataframe-sql
        deepnote_variable_name: df_por_pago
        deepnote_return_variable_type: dataframe
    - id: f3d005d6a0bb454993f5427c718fddf7
      blockGroup: f3d005d6a0bb454993f5427c718fddf7
      type: code
      sortingKey: bl
      content: |
        # El error clásico: olvidar el GROUP BY
        try:
            consulta("SELECT payment_type, COUNT(*) AS viajes FROM viajes")
        except Exception as error:
            print(type(error).__name__)
            print(str(error).splitlines()[0])
    - id: e71783238c554701990eca3508b1ae4a
      blockGroup: e71783238c554701990eca3508b1ae4a
      type: sql
      sortingKey: bm
      content: |
        SELECT
            COALESCE(z.Borough, 'Sin zona') AS borough,
            COUNT(*) AS viajes,
            ROUND(AVG(v.total_amount), 2) AS ticket_promedio
        FROM viajes AS v
        LEFT JOIN zonas AS z
            ON v.PULocationID = z.LocationID
        GROUP BY COALESCE(z.Borough, 'Sin zona')
        ORDER BY viajes DESC
      metadata:
        sql_integration_id: deepnote-dataframe-sql
        deepnote_variable_name: df_por_borough
        deepnote_return_variable_type: dataframe
    - id: d811da3dfc024fd2bcb898f781d907aa
      blockGroup: d811da3dfc024fd2bcb898f781d907aa
      type: sql
      sortingKey: bn
      content: |
        SELECT
            HOUR(tpep_pickup_datetime) AS hora,
            COUNT(*) AS viajes
        FROM viajes
        GROUP BY HOUR(tpep_pickup_datetime)
        ORDER BY hora
      metadata:
        sql_integration_id: deepnote-dataframe-sql
        deepnote_variable_name: df_por_hora
        deepnote_return_variable_type: dataframe
    - id: a86830ec2fa64a869053a1e8546236e7

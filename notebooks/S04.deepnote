    - id: ca499e72319747d0bed3ea23ec1aa61e
      blockGroup: ca499e72319747d0bed3ea23ec1aa61e
      type: text-cell-p
      sortingKey: bs
      content: 'Para el top 10 de zonas de origen: unir, agrupar, contar, ordenar y limitar. Agrupamos
        también por LocationID porque hay nombres de zona repetidos en la tabla.'
    - id: da1f3f1e61bd4b9da2e7353a7271a31b
      blockGroup: da1f3f1e61bd4b9da2e7353a7271a31b
      type: sql
      sortingKey: bt
      content: |
        SELECT
            z.Zone AS zona,
            z.Borough AS borough,
            COUNT(*) AS viajes
        FROM viajes AS v
        INNER JOIN zonas AS z
            ON v.PULocationID = z.LocationID
        GROUP BY z.LocationID, z.Zone, z.Borough
        ORDER BY viajes DESC
        LIMIT 10
      metadata:
        sql_integration_id: deepnote-dataframe-sql
        deepnote_variable_name: df_top10
        deepnote_return_variable_type: dataframe

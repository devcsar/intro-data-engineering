      content: |
        df_top10 = consulta("""
            SELECT
                z.Zone AS zona,
                z.Borough AS borough,
                COUNT(*) AS viajes
            FROM viajes AS v
            INNER JOIN zonas AS z
                ON v.PULocationID = z.LocationID
            GROUP BY z.LocationID, z.Zone, z.Borough
            ORDER BY viajes DESC
            LIMIT 10
        """)
        df_top10

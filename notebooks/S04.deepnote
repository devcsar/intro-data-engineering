      type: text-cell-h2
      sortingKey: bo
      content: 12. HAVING
    - id: 6e21f84cac52446e976abb8102763423
      blockGroup: 6e21f84cac52446e976abb8102763423
      type: text-cell-p
      sortingKey: bp
      content: WHERE filtra filas antes de agrupar. HAVING filtra grupos después de agrupar, y es donde
        van las agregaciones.
    - id: ad3c9cc337c54567ac1e1580a24a0c11
      blockGroup: ad3c9cc337c54567ac1e1580a24a0c11
      type: sql
      sortingKey: bq
      content: |
        SELECT
            PULocationID,
            COUNT(*) AS viajes,
            ROUND(AVG(total_amount), 2) AS ticket_promedio
        FROM viajes
        WHERE trip_distance > 0
        GROUP BY PULocationID
        HAVING COUNT(*) > 1000
        ORDER BY ticket_promedio DESC
        LIMIT 10
      metadata:
        sql_integration_id: deepnote-dataframe-sql
        deepnote_variable_name: df_having
        deepnote_return_variable_type: dataframe
    - id: fb65d180e9b64d1fa56562121e99d6da

      content: Verificación
    - id: d69dead327b24b649afed59b79838e66
      blockGroup: d69dead327b24b649afed59b79838e66
      type: text-cell-p
      sortingKey: cd
      content: Ejecuta esta celda para revisar tu trabajo. Si algo falla, el mensaje te dice qué corregir.
        Esta celda no se modifica.
    - id: 3c5a5ccfc2144b0fad32136fc7bcd711
      blockGroup: 3c5a5ccfc2144b0fad32136fc7bcd711
      type: code
      sortingKey: ce
      content: |
        def verificar_sesion_04():
            g = globals()
            pendientes = []

            def definido(nombre):
                return nombre in g and g[nombre] is not Ellipsis

            def columnas(df):
                return [str(c) for c in df.columns]

            def valores(df, columna):
                return list(df[columna])

            def revisar(nombre, ejercicio, columnas_esperadas):
                """Devuelve el DataFrame si existe y tiene las columnas esperadas, si no agrega un pendiente."""
                if not definido(nombre):
                    pendientes.append(f"{ejercicio}: falta el resultado {nombre}. Ejecuta el bloque SQL.")
                    return None
                df = g[nombre]
                if not hasattr(df, "columns") or columnas(df) != columnas_esperadas:
                    pendientes.append(f"{ejercicio}: las columnas de {nombre} deben ser {columnas_esperadas}.")
                    return None
                return df

            # Datos
            if not definido("viajes") or not definido("zonas"):
                pendientes.append("Falta cargar los datos: ejecuta la sección 0.")
            else:
                if g["viajes"].height != 2_964_624 or g["viajes"].width != 19:
                    pendientes.append("viajes no tiene el tamaño esperado (2,964,624 filas y 19 columnas).")
                if g["zonas"].height != 265:
                    pendientes.append("zonas no tiene las 265 zonas esperadas.")

            # Ejercicio 1: 5 viajes más caros
            df = revisar("df_ej1", "Ejercicio 1", ["PULocationID", "trip_distance", "total_amount"])
            if df is not None:
                totales = valores(df, "total_amount")
                if len(df) != 5:
                    pendientes.append("Ejercicio 1: el resultado debe tener 5 filas.")
                elif totales != sorted(totales, reverse=True):
                    pendientes.append("Ejercicio 1: ordena por total_amount de mayor a menor.")

            # Ejercicio 2: pasajeros nulos
            df = revisar("df_ej2", "Ejercicio 2", ["viajes_sin_pasajeros"])
            if df is not None:
                if len(df) != 1:
                    pendientes.append("Ejercicio 2: el resultado debe tener una sola fila.")
                else:
                    n = int(valores(df, "viajes_sin_pasajeros")[0])
                    if not 0 <= n <= 2_964_624:
                        pendientes.append("Ejercicio 2: el conteo no tiene sentido, revisa el WHERE.")

            # Ejercicio 3: viajes por borough con LEFT JOIN, la suma debe ser el total de filas
            df = revisar("df_ej3", "Ejercicio 3", ["borough", "viajes"])
            if df is not None:
                if sum(int(x) for x in valores(df, "viajes")) != 2_964_624:
                    pendientes.append("Ejercicio 3: la suma de viajes debe ser 2,964,624. Usa LEFT JOIN y COALESCE.")

            # Ejercicio 4: GROUP BY con HAVING
            df = revisar("df_ej4", "Ejercicio 4", ["tipo_pago", "viajes", "propina_promedio"])
            if df is not None:
                v = [int(x) for x in valores(df, "viajes")]
                if len(v) == 0:
                    pendientes.append("Ejercicio 4: el resultado está vacío, revisa el HAVING.")
                elif not all(x > 1000 for x in v):
                    pendientes.append("Ejercicio 4: todos los tipos deben tener más de 1000 viajes (HAVING).")
                elif v != sorted(v, reverse=True):
                    pendientes.append("Ejercicio 4: ordena por viajes de mayor a menor.")

            # Ejercicio 5: top 10
            df = revisar("df_ej5", "Ejercicio 5", ["zona", "borough", "viajes"])
            if df is not None:
                v = [int(x) for x in valores(df, "viajes")]
                if len(v) != 10:
                    pendientes.append("Ejercicio 5: el resultado debe tener 10 filas (LIMIT 10).")
                elif v != sorted(v, reverse=True):
                    pendientes.append("Ejercicio 5: ordena por viajes de mayor a menor.")

            if pendientes:
                for p in pendientes:
                    print("Pendiente:", p)
            else:
                print("Sesión 4 completa. Nos vemos en la siguiente.")


        verificar_sesion_04()

    - id: 49e896ec080b46fb9fa623153cd65735
      blockGroup: 49e896ec080b46fb9fa623153cd65735
      type: sql
      sortingKey: ap
      content: |
        SELECT
            payment_type AS tipo_pago,
            COUNT(*) AS viajes,
            ROUND(AVG(total_amount), 2) AS ticket_promedio
        FROM viajes
        GROUP BY payment_type
        ORDER BY viajes DESC
      metadata:
        sql_integration_id: deepnote-dataframe-sql
        deepnote_variable_name: df_pagos
        deepnote_return_variable_type: dataframe

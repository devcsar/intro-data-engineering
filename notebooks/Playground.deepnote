    - id: 46f78c5f5bdc4846aa200aef693f132c
      blockGroup: 46f78c5f5bdc4846aa200aef693f132c
      type: code
      sortingKey: ah
      content: |
        # Ejemplo: viajes y propina promedio por tipo de pago
        (
            viajes
            .group_by("payment_type")
            .agg(
                pl.len().alias("viajes"),
                pl.col("tip_amount").mean().alias("propina_promedio"),
            )
            .sort("viajes", descending=True)
        )
    - id: f6bcf22c22d648998c300b22309ce639
      blockGroup: f6bcf22c22d648998c300b22309ce639
      type: text-cell-h3
      sortingKey: ai
      content: Polars (lazy)
    - id: 4f8071b8ca304e6fb0371aaecb3878f7
      blockGroup: 4f8071b8ca304e6fb0371aaecb3878f7
      type: code
      sortingKey: aj
      content: |
        # Ejemplo: un plan lazy. Lee el plan con explain() y ejecútalo con collect()
        plan = (
            lf
            .filter(pl.col("trip_distance") > 0)
            .select("PULocationID", "total_amount")
        )

        print(plan.explain())
        plan.collect().head(5)
    - id: 1b812708c96245be90c68abd853a5bca
      blockGroup: 1b812708c96245be90c68abd853a5bca
      type: text-cell-h3
      sortingKey: ak
      content: SQL con DuckDB
    - id: 33f53b08015b4ffd8417a72a22ed9cc2
      blockGroup: 33f53b08015b4ffd8417a72a22ed9cc2
      type: code
      sortingKey: al
      content: |
        # Ejemplo: las 5 zonas de origen con más viajes
        duckdb.sql("""
            SELECT z.Zone, COUNT(*) AS viajes
            FROM viajes AS v
            LEFT JOIN zonas AS z ON v.PULocationID = z.LocationID
            GROUP BY z.LocationID, z.Zone
            ORDER BY viajes DESC
            LIMIT 5
        """).pl()

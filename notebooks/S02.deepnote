      sortingKey: b9
      content: |
        # Parámetros con valor por defecto, y usar el diccionario dentro de una función
        def etiqueta_pago(codigo, por_defecto="Desconocido"):
            return tipos_pago.get(codigo, por_defecto)


        print(etiqueta_pago(1))
        print(etiqueta_pago(2))
        print(etiqueta_pago(99))
        print(etiqueta_pago(99, "Otro"))


        def porcentaje_propina(propina, total):
            if total <= 0:
                return 0.0
            return round(propina / total * 100, 1)


        print(porcentaje_propina(5, 20))
        print(porcentaje_propina(5, 0))

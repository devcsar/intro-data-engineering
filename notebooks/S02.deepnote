    - id: 498ddb0c94014b04813fc96d25eb97e8
      blockGroup: 498ddb0c94014b04813fc96d25eb97e8
      type: code
      sortingKey: bc
      content: |
        import math
        import statistics
        from pathlib import Path

        print(math.sqrt(16))
        print(math.ceil(3.2))

        distancias = viajes["trip_distance"].head(100).to_list()
        print(round(statistics.mean(distancias), 2))
        print(round(statistics.median(distancias), 2))

        # La misma media en una línea con Polars
        print(round(viajes["trip_distance"].head(100).mean(), 2))

        # pathlib: preguntar si un archivo existe
        print(Path("datos/viajes_2024_01.parquet").exists())

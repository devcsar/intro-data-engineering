    - id: 6337b6e283944c209a9ed630ae8d8957
      blockGroup: 6337b6e283944c209a9ed630ae8d8957
      type: code
      sortingKey: b7
      content: |
        def clasificar_viaje(millas):
            """Devuelve 'corto', 'mediano' o 'largo' según la distancia."""
            if millas < 1:
                return "corto"
            elif millas <= 5:
                return "mediano"
            else:
                return "largo"


        print(clasificar_viaje(0.5))
        print(clasificar_viaje(3.4))
        print(clasificar_viaje(12))
    - id: f2823280fede4302ac2867993b6a8fa7
      blockGroup: f2823280fede4302ac2867993b6a8fa7
      type: code
      sortingKey: b8
      content: |
        # print muestra, return entrega
        def doble_con_print(n):
            print(n * 2)


        def doble_con_return(n):
            return n * 2


        a = doble_con_print(4)     # imprime 8 pero a queda en None
        b = doble_con_return(4)    # b vale 8
        print(a, b)
    - id: 703710ad8ad54d43a3a86c7de578bb2d
      blockGroup: 703710ad8ad54d43a3a86c7de578bb2d

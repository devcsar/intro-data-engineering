        t_csv = medir(lambda: pl.read_csv(RUTA_CSV), repeticiones=1)
        t_ndjson = medir(lambda: pl.read_ndjson(RUTA_NDJSON), repeticiones=1)

        print(f"Parquet {t_parquet:6.2f} s")
        print(f"CSV     {t_csv:6.2f} s")
        print(f"NDJSON  {t_ndjson:6.2f} s")

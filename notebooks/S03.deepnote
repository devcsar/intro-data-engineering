    - id: a5656781ae374c2a8353c4dd72c1f400
      blockGroup: a5656781ae374c2a8353c4dd72c1f400
      type: code
      sortingKey: bc
      content: |
        # 8.2 Convertir a CSV y a NDJSON (esta celda tarda, no la interrumpas)
        inicio = time.perf_counter()
        viajes.write_csv(RUTA_CSV)
        print(f"CSV escrito en {time.perf_counter() - inicio:.1f} s")

        inicio = time.perf_counter()
        viajes.write_ndjson(RUTA_NDJSON)
        print(f"NDJSON escrito en {time.perf_counter() - inicio:.1f} s")

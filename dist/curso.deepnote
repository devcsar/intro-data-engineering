      content: |
        # Borrar los archivos pesados para liberar espacio. Ejecutar solo después de verificar la sesión.
        for ruta in [RUTA_CSV, RUTA_NDJSON, *CARPETA.glob("prueba_*.parquet"), CARPETA / "latin1.csv", CARPETA / "muestra.ndjson"]:
            if Path(ruta).exists():
                Path(ruta).unlink()
        print("Archivos temporales borrados. Quedan:", sorted(p.name for p in CARPETA.iterdir()))

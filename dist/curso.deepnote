    - id: e03e8e9e9bed4fc282a84b37068f7607
      blockGroup: e03e8e9e9bed4fc282a84b37068f7607
      type: code
      sortingKey: b5
      content: |
        def verificar_sesion_01():
            fallos = []
            ns = globals()

            if viajes.height != 2_964_624:
                fallos.append("El dataset de viajes no tiene el número esperado de filas.")

            if not Path("datos/viajes_2024_01.parquet").exists():
                fallos.append("Falta guardar el parquet en la carpeta datos/.")

            # Ejercicio 1
            compartidos = ns.get("viajes_compartidos", ...)
            if compartidos is ...:
                fallos.append("El ejercicio 1 sigue sin resolver.")
            elif not isinstance(compartidos, int):
                fallos.append("viajes_compartidos debe ser un número entero.")

            # Ejercicio 2
            caro = ns.get("mas_caro", ...)
            if caro is ...:
                fallos.append("El ejercicio 2 sigue sin resolver.")
            elif not isinstance(caro, pl.DataFrame) or caro.height != 1:
                fallos.append("mas_caro debe ser una tabla de una sola fila.")

            # Ejercicio 3
            zona = ns.get("id_zona", ...)
            if zona is ...:
                fallos.append("El ejercicio 3 sigue sin resolver.")
            elif not isinstance(zona, int):
                fallos.append("id_zona debe ser un número entero.")
            elif isinstance(caro, pl.DataFrame) and caro.height == 1 and zona != caro["PULocationID"][0]:
                fallos.append("id_zona debe ser la zona de origen (PULocationID) del viaje más caro.")

            if fallos:
                for f in fallos:
                    print("Pendiente:", f)
            else:
                print("Sesión 1 completa. Nos vemos en la siguiente.")

        verificar_sesion_01()

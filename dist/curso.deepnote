    - id: 1be3d252e885486aa4204fcaff9c8ac6
      blockGroup: 1be3d252e885486aa4204fcaff9c8ac6
      type: text-cell-p
      sortingKey: ap
      content: WHERE filtra filas con comparaciones (=, >, <), BETWEEN, IN, LIKE y las combina con AND
        y OR.
    - id: c1d2beafa632475db2b4d15f037252ea
      blockGroup: c1d2beafa632475db2b4d15f037252ea
      type: sql
      sortingKey: aq
      content: |
        SELECT
            PULocationID,
            trip_distance,
            total_amount,
            payment_type
        FROM viajes
        WHERE trip_distance > 0
          AND total_amount BETWEEN 10 AND 100
          AND payment_type IN (1, 2)
        LIMIT 10
      metadata:

    - id: 1f731ed798454802bcfacd6db1a95ced
      blockGroup: 1f731ed798454802bcfacd6db1a95ced
      type: text-cell-p
      sortingKey: ak
      content: SELECT elige las columnas, FROM dice de qué tabla, AS les pone un alias y LIMIT corta el
        número de filas.

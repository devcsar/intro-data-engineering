      content: |
        # Construir la tabla del reporte con los números de esta máquina
        filas = [
            {"formato": "CSV", "tamano_mb": round(tamano_mb(RUTA_CSV), 1), "segundos_lectura": round(t_csv, 2)},
            {"formato": "NDJSON", "tamano_mb": round(tamano_mb(RUTA_NDJSON), 1), "segundos_lectura": round(t_ndjson, 2)},
            {"formato": "Parquet", "tamano_mb": round(tamano_mb(RUTA_PARQUET), 1), "segundos_lectura": round(t_parquet, 2)},
        ]
        reporte = pl.DataFrame(filas)

        # Cuántas veces pesa cada formato contra el Parquet
        tamano_parquet = reporte.filter(pl.col("formato") == "Parquet")["tamano_mb"][0]
        reporte = reporte.with_columns(
            (pl.col("tamano_mb") / tamano_parquet).round(1).alias("veces_vs_parquet")
        )
        reporte

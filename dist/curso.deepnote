    - id: 944c08403fdc420bae8969ab911143da
      blockGroup: 944c08403fdc420bae8969ab911143da
      type: code
      sortingKey: c3
      content: |
        def verificar_sesion_03():
            g = globals()
            pendientes = []

            def definido(nombre):
                return nombre in g and g[nombre] is not Ellipsis

            # Datos y archivos
            if not definido("viajes"):
                pendientes.append("Falta cargar viajes: ejecuta la sección 1.")
            elif g["viajes"].height != 2_964_624 or g["viajes"].width != 19:
                pendientes.append("viajes no tiene el tamaño esperado (2,964,624 filas y 19 columnas).")

            for nombre_ruta, etiqueta in [("RUTA_PARQUET", "el Parquet"), ("RUTA_CSV", "el CSV"), ("RUTA_NDJSON", "el NDJSON")]:
                if not definido(nombre_ruta) or not g[nombre_ruta].exists():
                    pendientes.append(f"Falta guardar {etiqueta}: ejecuta la sección 8.")

            # Ejercicio 1
            if not definido("tipos_por_columna"):
                pendientes.append("Ejercicio 1: falta tipos_por_columna.")
            elif not isinstance(g["tipos_por_columna"], dict) or len(g["tipos_por_columna"]) != 19:
                pendientes.append("Ejercicio 1: tipos_por_columna debe ser un diccionario con 19 columnas.")
            elif not all(isinstance(v, str) for v in g["tipos_por_columna"].values()):
                pendientes.append("Ejercicio 1: los tipos deben estar escritos como texto (usa str()).")

            # Ejercicio 2
            if not definido("viajes_min"):
                pendientes.append("Ejercicio 2: falta viajes_min.")
            else:
                v = g["viajes_min"]
                if sorted(v.columns) != ["PULocationID", "payment_type", "total_amount"]:
                    pendientes.append("Ejercicio 2: viajes_min debe tener solo PULocationID, payment_type y total_amount.")
                elif v.height != 2_964_624:
                    pendientes.append("Ejercicio 2: viajes_min debe tener todas las filas.")

            # Ejercicio 3
            if not definido("n_muestra"):
                pendientes.append("Ejercicio 3: falta n_muestra.")
            elif g["n_muestra"] != 1000:
                pendientes.append("Ejercicio 3: n_muestra debe ser 1000.")

            # Ejercicio 4
            if not definido("columnas_distintas"):
                pendientes.append("Ejercicio 4: falta columnas_distintas.")
            elif not isinstance(g["columnas_distintas"], list):
                pendientes.append("Ejercicio 4: columnas_distintas debe ser una lista.")
            elif "tpep_pickup_datetime" not in g["columnas_distintas"]:
                pendientes.append("Ejercicio 4: tpep_pickup_datetime debería estar en la lista, el CSV la lee como texto.")

            # Ejercicio 5: reporte y conclusión
            if not definido("reporte"):
                pendientes.append("Ejercicio 5: falta la tabla reporte.")
            else:
                r = g["reporte"]
                columnas_esperadas = {"formato", "tamano_mb", "segundos_lectura", "veces_vs_parquet"}
                if not hasattr(r, "columns") or not columnas_esperadas.issubset(set(r.columns)):
                    pendientes.append("Ejercicio 5: reporte debe tener formato, tamano_mb, segundos_lectura y veces_vs_parquet.")
                elif set(r["formato"].to_list()) != {"CSV", "NDJSON", "Parquet"}:
                    pendientes.append("Ejercicio 5: reporte debe tener una fila para CSV, NDJSON y Parquet.")
                else:
                    tamanos = dict(zip(r["formato"].to_list(), r["tamano_mb"].to_list()))
                    if not tamanos["Parquet"] < tamanos["CSV"]:
                        pendientes.append("Ejercicio 5: el Parquet debería pesar menos que el CSV, revisa tus mediciones.")

            if not definido("conclusion") or not isinstance(g["conclusion"], str):
                pendientes.append("Ejercicio 5: falta escribir la conclusión (variable conclusion).")
            elif len(g["conclusion"].split()) < 25:
                pendientes.append("Ejercicio 5: la conclusión es muy corta, escribe al menos 3 frases.")

            if pendientes:
                for p in pendientes:
                    print("Pendiente:", p)
            else:
                print("Sesión 3 completa. Nos vemos en la siguiente.")


        verificar_sesion_03()

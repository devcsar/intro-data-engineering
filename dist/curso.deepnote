      content: |
        # Los códigos de payment_type del diccionario de datos de la TLC
        tipos_pago = {
            0: "Flex Fare",
            1: "Tarjeta de crédito",
            2: "Efectivo",
            3: "Sin cargo",
            4: "Disputa",
            5: "Desconocido",
            6: "Viaje anulado",
        }

        print(tipos_pago[2])                  # Efectivo
        print(tipos_pago.get(2))              # Efectivo
        print(tipos_pago.get(9, "Otro"))      # Otro, no falla aunque la llave no exista

        tipos_pago[7] = "Código nuevo"        # agregar o cambiar una pareja
        print(len(tipos_pago))
        del tipos_pago[7]                     # quitar una pareja

        for codigo, nombre in tipos_pago.items():
            print(codigo, "->", nombre)

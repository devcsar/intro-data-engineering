    - id: 1ea9292b642f420eb00773e7712ddabc
      blockGroup: 1ea9292b642f420eb00773e7712ddabc
      type: sql
      sortingKey: am
      content: |
        SELECT
            PULocationID AS zona_origen,
            trip_distance AS millas,
            ROUND(trip_distance * 1.60934, 2) AS kilometros,
            total_amount AS total
        FROM viajes
        LIMIT 5
      metadata:
        sql_integration_id: deepnote-dataframe-sql
        deepnote_variable_name: df_alias
        deepnote_return_variable_type: dataframe
    - id: efc4a65c37de4d12a63eb517caf4cea9
      blockGroup: efc4a65c37de4d12a63eb517caf4cea9
      type: code
      sortingKey: an
      content: |
        df_alias = consulta("""
            SELECT
                PULocationID AS zona_origen,
                trip_distance AS millas,
                ROUND(trip_distance * 1.60934, 2) AS kilometros,
                total_amount AS total
            FROM viajes
            LIMIT 5
        """)
        df_alias
    - id: e838d0907e264145a4ef4fff425eff1e
      blockGroup: e838d0907e264145a4ef4fff425eff1e

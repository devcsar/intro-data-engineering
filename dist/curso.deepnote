      blockGroup: 6e53d086ff18467c8bbd4b16a547295b
      type: code
      sortingKey: ay
      content: |
        # Compresión: el mismo DataFrame escrito con distintos códecs
        MB = 1_048_576

        def tamano_mb(ruta):
            return Path(ruta).stat().st_size / MB

        for codec in ["uncompressed", "snappy", "zstd"]:
            ruta = CARPETA / f"prueba_{codec}.parquet"
            viajes.write_parquet(ruta, compression=codec)
            print(f"{codec:<13} {tamano_mb(ruta):8.1f} MB")

    - id: 7bb45307c933443a8514ec5f3bb4db6b
      blockGroup: 7bb45307c933443a8514ec5f3bb4db6b
      type: text-cell-p
      sortingKey: b1
      content: 'Como Parquet guarda cada columna por separado, se pueden leer solo las columnas que necesitas
        (column pruning). Y con las estadísticas de cada bloque se pueden saltar bloques completos al
        filtrar (predicate pushdown). El plan de consulta lo muestra: busca PROJECT y SELECTION.'
    - id: 29ff55f33a7c4070bd42f68afbf2dcff
      blockGroup: 29ff55f33a7c4070bd42f68afbf2dcff
      type: code
      sortingKey: b2
      content: |
        # Medir tiempos de forma repetible
        def medir(funcion, repeticiones=3):
            """Ejecuta funcion varias veces y devuelve el mejor tiempo en segundos."""
            tiempos = []
            for _ in range(repeticiones):
                inicio = time.perf_counter()
                funcion()
                tiempos.append(time.perf_counter() - inicio)
            return min(tiempos)


        COLUMNAS = ["tpep_pickup_datetime", "PULocationID", "total_amount"]

        t_todo = medir(lambda: pl.read_parquet(RUTA_PARQUET))
        t_poda = medir(lambda: pl.read_parquet(RUTA_PARQUET, columns=COLUMNAS))
        print(f"Leer las 19 columnas: {t_todo:.2f} s")
        print(f"Leer solo 3 columnas: {t_poda:.2f} s")
    - id: 2604fe2f387846248ccbbedbca111491
      blockGroup: 2604fe2f387846248ccbbedbca111491
      type: code
      sortingKey: b3
      content: |
        # El plan de consulta muestra la poda de columnas y el filtro empujado a la lectura
        plan = (
            pl.scan_parquet(RUTA_PARQUET)
            .select(COLUMNAS)
            .filter(pl.col("total_amount") > 100)
        )
        print(plan.explain())

                (0, 'Flex Fare'), (1, 'Tarjeta'), (2, 'Efectivo'), (3, 'Sin cargo'),
                (4, 'Disputa'), (5, 'Desconocido'), (6, 'Cancelado')
            ) AS t(pago_key, metodo_pago)
        """)
        con.sql("SELECT * FROM dim_pago").show()

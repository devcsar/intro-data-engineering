      type: code
      sortingKey: bz
      content: |
        def verificar_sesion_02():
            g = globals()
            pendientes = []

            def definido(nombre):
                return nombre in g and g[nombre] is not Ellipsis

            def igual(a, b):
                try:
                    return abs(a - b) < 1e-9
                except Exception:
                    return False

            # Datos de la sesión
            if not definido("viajes") or not definido("zonas"):
                pendientes.append("Falta cargar los datos: ejecuta la sección 0.")
            else:
                if g["viajes"].height != 2_964_624 or g["viajes"].width != 19:
                    pendientes.append("viajes no tiene el tamaño esperado (2,964,624 filas y 19 columnas).")
                if g["zonas"].height != 265:
                    pendientes.append("zonas no tiene las 265 zonas esperadas.")

            # Ejercicio 1
            if not definido("costo_por_milla"):
                pendientes.append("Ejercicio 1: falta costo_por_milla.")
            elif not igual(g["costo_por_milla"], 8.5):
                pendientes.append("Ejercicio 1: costo_por_milla debe ser 25.5 dividido entre 3.0.")

            # Ejercicio 2
            if not definido("n_aeropuertos") or not definido("zonas_ejemplo"):
                pendientes.append("Ejercicio 2: falta n_aeropuertos.")
            else:
                esperado = sum(1 for z in g["zonas_ejemplo"] if "Airport" in z)
                if g["n_aeropuertos"] != esperado:
                    pendientes.append("Ejercicio 2: n_aeropuertos no coincide con las zonas que dicen Airport.")

            # Ejercicio 3
            if not definido("etiqueta_pago") or not callable(g["etiqueta_pago"]):
                pendientes.append("Ejercicio 3: falta la función etiqueta_pago.")
            else:
                try:
                    f = g["etiqueta_pago"]
                    if (f(1), f(2), f(99)) != ("Tarjeta de crédito", "Efectivo", "Desconocido"):
                        pendientes.append("Ejercicio 3: etiqueta_pago devuelve valores incorrectos.")
                except Exception as e:
                    pendientes.append(f"Ejercicio 3: etiqueta_pago falla con {type(e).__name__}.")

            # Ejercicio 4
            if not definido("clasificar_viaje") or not callable(g["clasificar_viaje"]):
                pendientes.append("Ejercicio 4: falta la función clasificar_viaje.")
            else:
                try:
                    c = g["clasificar_viaje"]
                    if (c(0.5), c(1), c(5), c(5.1)) != ("corto", "mediano", "mediano", "largo"):
                        pendientes.append("Ejercicio 4: clasificar_viaje no respeta los límites (1 y 5 son medianos).")
                except Exception as e:
                    pendientes.append(f"Ejercicio 4: clasificar_viaje falla con {type(e).__name__}.")

            # Ejercicio 5
            if not definido("n_largos"):
                pendientes.append("Ejercicio 5: falta n_largos.")
            elif not definido("viajes"):
                pendientes.append("Ejercicio 5: falta cargar viajes.")
            else:
                ref = g["viajes"]["trip_distance"].head(100).to_list()
                if g["n_largos"] != sum(1 for d in ref if d > 5):
                    pendientes.append("Ejercicio 5: n_largos no coincide con las distancias mayores a 5 de las primeras 100.")

            # Taller de errores
            esperados = {
                "resultado_1": 7.77,
                "resultado_2": "Pasajeros en el viaje: 3",
                "resultado_3": "Otro",
                "resultado_4": "Times Sq/Theatre District",
                "resultado_5": True,
            }
            for nombre, valor in esperados.items():
                n = nombre[-1]
                if not definido(nombre):
                    pendientes.append(f"Taller, celda {n}: sigue rota o no tiene {nombre}.")
                elif g[nombre] != valor or type(g[nombre]) is not type(valor):
                    pendientes.append(f"Taller, celda {n}: {nombre} no tiene el valor esperado.")

            if pendientes:
                for p in pendientes:
                    print("Pendiente:", p)
            else:
                print("Sesión 2 completa. Nos vemos en la siguiente.")


        verificar_sesion_02()

      blockGroup: 4acfb2a11bd745cb87bb41d915fb9a70
      type: code
      sortingKey: b4
      content: |
        # Acumular sobre una muestra real: suma de distancias y cuántos viajes largos
        distancias = viajes["trip_distance"].head(10).to_list()
        suma = 0.0
        largos = 0
        for d in distancias:
            suma += d
            if d > 5:
                largos += 1

        print(f"Suma de 10 distancias: {suma:.2f}")
        print(f"Promedio: {suma / len(distancias):.2f}")
        print(f"Viajes largos en la muestra: {largos}")

        # El mismo cálculo con una comprensión de listas (atajo opcional)
        largos_2 = len([d for d in distancias if d > 5])
        print(largos_2 == largos)

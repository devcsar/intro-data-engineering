    - id: e71783238c554701990eca3508b1ae4a
      blockGroup: e71783238c554701990eca3508b1ae4a
      type: sql
      sortingKey: bm
      content: |
        SELECT
            COALESCE(z.Borough, 'Sin zona') AS borough,
            COUNT(*) AS viajes,
            ROUND(AVG(v.total_amount), 2) AS ticket_promedio
        FROM viajes AS v
        LEFT JOIN zonas AS z
            ON v.PULocationID = z.LocationID
        GROUP BY COALESCE(z.Borough, 'Sin zona')
        ORDER BY viajes DESC
      metadata:
        sql_integration_id: deepnote-dataframe-sql
        deepnote_variable_name: df_por_borough
        deepnote_return_variable_type: dataframe

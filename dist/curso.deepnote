    - id: fac780a0125242499a25b7db9ef18d3b
      blockGroup: fac780a0125242499a25b7db9ef18d3b
      type: code
      sortingKey: a7
      content: |
        import polars as pl
        import duckdb
        from pathlib import Path

        URL_VIAJES = "https://d37ci6vzurychx.cloudfront.net/trip-data/yellow_tripdata_2024-01.parquet"
        URL_ZONAS = "https://d37ci6vzurychx.cloudfront.net/misc/taxi_zone_lookup.csv"

        Path("datos").mkdir(exist_ok=True)
        RUTA_VIAJES = Path("datos/viajes_2024_01.parquet")
        RUTA_ZONAS = Path("datos/zonas.csv")

        # Si el archivo ya existe en datos/ (sesión 1) se lee de ahí, si no, se descarga
        viajes = pl.read_parquet(RUTA_VIAJES if RUTA_VIAJES.exists() else URL_VIAJES)
        zonas = pl.read_csv(RUTA_ZONAS if RUTA_ZONAS.exists() else URL_ZONAS)

        if not RUTA_VIAJES.exists():
            viajes.write_parquet(RUTA_VIAJES)
        if not RUTA_ZONAS.exists():
            zonas.write_csv(RUTA_ZONAS)

        print(f"Viajes: {viajes.height:,} filas x {viajes.width} columnas")
        print(f"Zonas:  {zonas.height:,} filas x {zonas.width} columnas")
    - id: 60181c159ce144dd962b5b3664a976f2
      blockGroup: 60181c159ce144dd962b5b3664a976f2
      type: text-cell-h2
      sortingKey: a8
      content: 2. Subconsultas
    - id: eedb19bdbabc40fd855b20129c8e5e57
      blockGroup: eedb19bdbabc40fd855b20129c8e5e57
      type: text-cell-p
      sortingKey: a9
      content: Una subconsulta es una consulta dentro de otra, entre paréntesis. Puede ir en WHERE (para
        comparar contra un valor calculado), con IN (contra una lista) o en FROM (como una tabla temporal,
        con alias).
    - id: 870b6349dcaa41749128e1cae325b819
      blockGroup: 870b6349dcaa41749128e1cae325b819
      type: sql
      sortingKey: aa
      content: |
        -- Viajes que cuestan más que el promedio
        SELECT COUNT(*) AS viajes_sobre_promedio
        FROM viajes
        WHERE total_amount > (SELECT AVG(total_amount) FROM viajes)
      metadata:
        sql_integration_id: deepnote-dataframe-sql
        deepnote_variable_name: df_sobre_promedio
        deepnote_return_variable_type: dataframe
    - id: af0a11c9ccda4ec9baab28a24bf2779c
      blockGroup: af0a11c9ccda4ec9baab28a24bf2779c
      type: sql
      sortingKey: ab
      content: |
        -- Origen en zonas de Manhattan, usando IN con una subconsulta
        SELECT PULocationID, COUNT(*) AS viajes
        FROM viajes
        WHERE PULocationID IN (SELECT LocationID FROM zonas WHERE Borough = 'Manhattan')
        GROUP BY PULocationID
        ORDER BY viajes DESC
        LIMIT 5
      metadata:
        sql_integration_id: deepnote-dataframe-sql
        deepnote_variable_name: df_manhattan
        deepnote_return_variable_type: dataframe
    - id: 34958ddba0134dc293fefb76f964c3fb
      blockGroup: 34958ddba0134dc293fefb76f964c3fb
      type: sql
      sortingKey: ac
      content: |
        -- Subconsulta en FROM: primero viajes por zona, luego su promedio
        SELECT AVG(viajes) AS promedio_viajes_por_zona
        FROM (
            SELECT PULocationID, COUNT(*) AS viajes
            FROM viajes
            GROUP BY PULocationID
        ) AS por_zona
      metadata:
        sql_integration_id: deepnote-dataframe-sql
        deepnote_variable_name: df_promedio_zona
        deepnote_return_variable_type: dataframe
    - id: 001d18cb0c5d4abf84315086affecc6f
      blockGroup: 001d18cb0c5d4abf84315086affecc6f
      type: text-cell-h2
      sortingKey: ad
      content: 3. CTEs
    - id: 9154461989104a2caf5cfd49cbd17d20
      blockGroup: 9154461989104a2caf5cfd49cbd17d20
      type: text-cell-p
      sortingKey: ae
      content: Una CTE le pone nombre a un paso de la consulta con WITH nombre AS (...). Se lee de arriba
        hacia abajo, como una receta. Varias CTEs se encadenan con comas y cada una puede usar las anteriores.
    - id: 7fcf700fd2a14ec7ada19606acf8cb78
      blockGroup: 7fcf700fd2a14ec7ada19606acf8cb78
      type: sql
      sortingKey: af
      content: |
        WITH viajes_por_dia AS (
            SELECT
                CAST(tpep_pickup_datetime AS DATE) AS dia,
                COUNT(*) AS n_viajes,
                SUM(total_amount) AS ingreso
            FROM viajes
            GROUP BY 1
        )
        SELECT
            dia,
            n_viajes,
            ingreso,
            RANK() OVER (ORDER BY ingreso DESC) AS ranking
        FROM viajes_por_dia
        ORDER BY ranking
        LIMIT 10
      metadata:
        sql_integration_id: deepnote-dataframe-sql
        deepnote_variable_name: df_ranking_dias
        deepnote_return_variable_type: dataframe
    - id: 2a44a696d08c4b58a83b888fdc824fce
      blockGroup: 2a44a696d08c4b58a83b888fdc824fce
      type: sql
      sortingKey: ag
      content: |
        WITH viajes_limpios AS (
            SELECT *
            FROM viajes
            WHERE trip_distance > 0 AND total_amount > 0
        ),
        por_zona AS (
            SELECT
                PULocationID,
                COUNT(*) AS viajes,
                AVG(total_amount) AS ticket_promedio
            FROM viajes_limpios
            GROUP BY PULocationID
        )
        SELECT
            z.Zone,
            p.viajes,
            ROUND(p.ticket_promedio, 2) AS ticket_promedio
        FROM por_zona AS p
        JOIN zonas AS z ON p.PULocationID = z.LocationID
        ORDER BY p.viajes DESC
        LIMIT 10
      metadata:
        sql_integration_id: deepnote-dataframe-sql
        deepnote_variable_name: df_zonas_limpias
        deepnote_return_variable_type: dataframe
    - id: cbf63d79e780429db9cb103c99a51544
      blockGroup: cbf63d79e780429db9cb103c99a51544
      type: text-cell-h2
      sortingKey: ah
      content: 4. CASE WHEN
    - id: cf606c5d351a431ba171a42af3f19df4
      blockGroup: cf606c5d351a431ba171a42af3f19df4
      type: text-cell-p
      sortingKey: ai
      content: 'CASE WHEN pone condiciones dentro de la consulta para crear categorías. Termina con END
        y conviene siempre poner ELSE: sin él, las filas que no cumplen ninguna condición quedan en NULL.'
    - id: d28ebe478c614c30a54f19f80d8ffcbb
      blockGroup: d28ebe478c614c30a54f19f80d8ffcbb
      type: sql
      sortingKey: aj
      content: |
        SELECT
            CASE
                WHEN trip_distance = 0 THEN 'sin distancia'
                WHEN trip_distance < 2 THEN 'corto'
                WHEN trip_distance < 10 THEN 'medio'
                ELSE 'largo'
            END AS tipo_viaje,
            COUNT(*) AS viajes,
            ROUND(AVG(total_amount), 2) AS ticket_promedio
        FROM viajes
        GROUP BY tipo_viaje
        ORDER BY viajes DESC
      metadata:
        sql_integration_id: deepnote-dataframe-sql
        deepnote_variable_name: df_tipo_viaje
        deepnote_return_variable_type: dataframe
    - id: c45de44084224e1f91c51a1d5efee7c9
      blockGroup: c45de44084224e1f91c51a1d5efee7c9
      type: sql
      sortingKey: ak
      content: |
        -- CASE con valor exacto: traduce el código de payment_type
        SELECT
            CASE payment_type
                WHEN 0 THEN 'Flex Fare'
                WHEN 1 THEN 'Tarjeta'
                WHEN 2 THEN 'Efectivo'
                WHEN 3 THEN 'Sin cargo'
                WHEN 4 THEN 'Disputa'
                WHEN 5 THEN 'Desconocido'
                WHEN 6 THEN 'Cancelado'
                ELSE 'Otro'
            END AS metodo_pago,
            COUNT(*) AS viajes
        FROM viajes
        GROUP BY metodo_pago
        ORDER BY viajes DESC
      metadata:
        sql_integration_id: deepnote-dataframe-sql
        deepnote_variable_name: df_metodo_pago
        deepnote_return_variable_type: dataframe
    - id: 19ef625d6c7146d8b3d5c9b4d17a9c7e
      blockGroup: 19ef625d6c7146d8b3d5c9b4d17a9c7e
      type: text-cell-h2
      sortingKey: al
      content: 5. Window functions
    - id: edf5e468193c4788b1fc1a1f641cd867
      blockGroup: edf5e468193c4788b1fc1a1f641cd867
      type: text-cell-p
      sortingKey: am
      content: 'Una window function calcula sobre un grupo sin colapsar las filas: cada fila conserva
        su detalle y recibe un valor extra. OVER define la ventana, PARTITION BY la divide en grupos y
        ORDER BY la ordena. RANK deja huecos en los empates y ROW_NUMBER no.'
    - id: ae82264039a54c48977a80722c94cbaa
      blockGroup: ae82264039a54c48977a80722c94cbaa
      type: sql
      sortingKey: an
      content: |
        -- Ranking global de zonas de origen. Compara RANK contra ROW_NUMBER en los empates
        SELECT
            Borough,
            Zone,
            viajes,
            RANK() OVER (ORDER BY viajes DESC) AS rank_global,
            ROW_NUMBER() OVER (ORDER BY viajes DESC) AS fila_global
        FROM (
            SELECT z.Borough, z.Zone, COUNT(*) AS viajes
            FROM viajes AS v
            JOIN zonas AS z ON v.PULocationID = z.LocationID
            GROUP BY z.Borough, z.Zone
        )
        ORDER BY rank_global
        LIMIT 10
      metadata:
        sql_integration_id: deepnote-dataframe-sql
        deepnote_variable_name: df_ranking_zonas
        deepnote_return_variable_type: dataframe
    - id: c35b6bd58f7f4f0ea544b9fdfad98900
      blockGroup: c35b6bd58f7f4f0ea544b9fdfad98900
      type: sql
      sortingKey: ao
      content: |
        WITH por_zona AS (
            SELECT z.Borough, z.Zone, COUNT(*) AS viajes
            FROM viajes AS v
            JOIN zonas AS z ON v.PULocationID = z.LocationID
            GROUP BY z.Borough, z.Zone
        ),
        ordenadas AS (
            SELECT
                Borough,
                Zone,
                viajes,
                ROW_NUMBER() OVER (PARTITION BY Borough ORDER BY viajes DESC) AS posicion
            FROM por_zona
        )
        SELECT *
        FROM ordenadas
        WHERE posicion <= 3
        ORDER BY Borough, posicion
      metadata:
        sql_integration_id: deepnote-dataframe-sql
        deepnote_variable_name: df_top3_borough
        deepnote_return_variable_type: dataframe
    - id: e6167223cb3c44d4b4490d54a17cd203
      blockGroup: e6167223cb3c44d4b4490d54a17cd203
      type: sql
      sortingKey: ap
      content: |
        -- Mismo resultado, sin la segunda CTE. QUALIFY existe en DuckDB, no en todas las bases de datos
        WITH por_zona AS (
            SELECT z.Borough, z.Zone, COUNT(*) AS viajes
            FROM viajes AS v
            JOIN zonas AS z ON v.PULocationID = z.LocationID
            GROUP BY z.Borough, z.Zone
        )
        SELECT
            Borough,
            Zone,
            viajes,
            ROW_NUMBER() OVER (PARTITION BY Borough ORDER BY viajes DESC) AS posicion
        FROM por_zona
        QUALIFY posicion <= 3
        ORDER BY Borough, posicion
      metadata:
        sql_integration_id: deepnote-dataframe-sql
        deepnote_variable_name: df_top3_qualify
        deepnote_return_variable_type: dataframe
    - id: 07535a80496d48f8aa8e86bde0b93900
      blockGroup: 07535a80496d48f8aa8e86bde0b93900
      type: sql
      sortingKey: aq
      content: |
        WITH ingreso_diario AS (
            SELECT
                CAST(tpep_pickup_datetime AS DATE) AS dia,
                SUM(total_amount) AS ingreso
            FROM viajes
            GROUP BY 1
        )
        SELECT
            dia,
            ROUND(ingreso, 2) AS ingreso,
            ROUND(SUM(ingreso) OVER (ORDER BY dia), 2) AS ingreso_acumulado
        FROM ingreso_diario
        ORDER BY dia
        LIMIT 10
      metadata:
        sql_integration_id: deepnote-dataframe-sql
        deepnote_variable_name: df_acumulado
        deepnote_return_variable_type: dataframe
    - id: d839cdb5f4974449937535545f6951c3
      blockGroup: d839cdb5f4974449937535545f6951c3
      type: text-cell-h2
      sortingKey: ar
      content: 6. Normalizado contra desnormalizado
    - id: 8818ca8e2b7a4144a28133aa7b5be02e
      blockGroup: 8818ca8e2b7a4144a28133aa7b5be02e
      type: text-cell-p
      sortingKey: as
      content: Normalizar es repartir los datos en varias tablas para no repetirlos (OLTP, el sistema
        que registra cada viaje). Desnormalizar es juntarlos en una tabla ancha, con el nombre de la zona
        escrito en cada fila, para que las consultas de análisis sean simples (OLAP). Compara el tamaño
        en memoria de las dos formas.
    - id: 3c3f33a2948042bcb1673110822838a0
      blockGroup: 3c3f33a2948042bcb1673110822838a0
      type: code
      sortingKey: at
      content: |
        # Desnormalizar: una sola tabla ancha, con los nombres de zona ya escritos en cada fila
        desnormalizada = duckdb.sql("""
            SELECT
                v.*,
                o.Borough AS borough_origen,
                o.Zone    AS zona_origen,
                d.Borough AS borough_destino,
                d.Zone    AS zona_destino
            FROM viajes AS v
            LEFT JOIN zonas AS o ON v.PULocationID = o.LocationID
            LEFT JOIN zonas AS d ON v.DOLocationID = d.LocationID
        """).pl()

        print("Normalizado, viajes:", viajes.shape, f"{viajes.estimated_size('mb'):.0f} MB")
        print("Desnormalizado:     ", desnormalizada.shape, f"{desnormalizada.estimated_size('mb'):.0f} MB")

        # El nombre de la zona se repite en cada fila
        muestra_zonas = desnormalizada.select("zona_origen").head(5)

        # La tabla ancha ocupa más memoria que viajes. La máquina tiene 5 GB, así que la liberamos cuando ya no se usa
        del desnormalizada
        muestra_zonas
    - id: 80323c1aaddb4e29bfb2a34ee2bc2a23
      blockGroup: 80323c1aaddb4e29bfb2a34ee2bc2a23
      type: text-cell-h2
      sortingKey: au
      content: 7. Lakehouse, medallion y ELT
    - id: cd0e0246387d45668a47513dae72b7af
      blockGroup: cd0e0246387d45668a47513dae72b7af
      type: text-cell-p
      sortingKey: av
      content: 'La arquitectura medallion organiza los datos en tres capas. Bronze: el dato crudo tal
        como llegó (el parquet original). Silver: el dato limpio (sin viajes de distancia cero). Gold:
        el dato agregado y listo para consumir (ingreso por día). ETL transforma antes de cargar, ELT
        carga lo crudo primero y transforma dentro del motor. Lo que haces aquí con SQL es ELT.'
    - id: 1019b15397e94c68b44e1e3a521d8214
      blockGroup: 1019b15397e94c68b44e1e3a521d8214
      type: code
      sortingKey: aw
      content: |
        con = duckdb.connect()          # base de datos DuckDB en memoria
        con.register("viajes", viajes)  # le presentamos el DataFrame como tabla

        # Bronze: el dato crudo, tal como llegó
        con.sql("CREATE VIEW bronze AS SELECT * FROM viajes")

        # Silver: limpio. Aquí se quitan los viajes con distancia o importe no positivo
        con.sql("""
            CREATE VIEW silver AS
            SELECT *
            FROM bronze
            WHERE trip_distance > 0 AND total_amount > 0
        """)

        # Gold: agregado, listo para el consumo (un tablero, por ejemplo)
        con.sql("""
            CREATE TABLE gold_ingreso_diario AS
            SELECT
                CAST(tpep_pickup_datetime AS DATE) AS dia,
                COUNT(*) AS viajes,
                ROUND(SUM(total_amount), 2) AS ingreso
            FROM silver
            GROUP BY 1
        """)

        con.sql("SELECT * FROM gold_ingreso_diario ORDER BY dia LIMIT 5").show()
        print("Bronze:", con.sql("SELECT COUNT(*) FROM bronze").fetchone()[0])
        print("Silver:", con.sql("SELECT COUNT(*) FROM silver").fetchone()[0])
    - id: 5e0045a4db734303945cb5fcd8fdbd4b
      blockGroup: 5e0045a4db734303945cb5fcd8fdbd4b
      type: code
      sortingKey: ax
      content: |
        # ETL: se transforma ANTES de cargar (aquí con Polars, fuera del destino)
        silver_etl = viajes.filter((pl.col("trip_distance") > 0) & (pl.col("total_amount") > 0))
        print(f"Silver con ETL: {silver_etl.height:,} filas")
        del silver_etl   # liberamos memoria, ya no la necesitamos

        # ELT: se carga lo crudo (bronze) y se transforma DENTRO del motor SQL (silver, gold)
        # Lo que ya hicimos en la celda anterior es ELT.

        # Guardar la capa gold como Parquet para el consumo
        con.sql("COPY gold_ingreso_diario TO 'datos/gold_ingreso_diario.parquet' (FORMAT PARQUET)")
        print(pl.read_parquet("datos/gold_ingreso_diario.parquet").head(3))

        zonas_ejemplo = [
            "JFK Airport",
            "Midtown Center",
            "LaGuardia Airport",
            "Upper East Side South",
            "Times Sq/Theatre District",
        ]

        print(len(zonas_ejemplo))       # 5
        print(zonas_ejemplo[0])         # primero, el índice empieza en 0
        print(zonas_ejemplo[-1])        # último
        print(zonas_ejemplo[1:3])       # rebanada, el 3 no se incluye

        zonas_ejemplo.append("Penn Station/Madison Sq West")
        print(len(zonas_ejemplo))       # 6
        print("JFK Airport" in zonas_ejemplo)

        # sorted() no cambia la lista original, devuelve una nueva
        print(sorted(zonas_ejemplo))
        print(zonas_ejemplo)
